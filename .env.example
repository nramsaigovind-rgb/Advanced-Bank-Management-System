# ==========================================
# Advanced Bank Management System Environment
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=super-secret-bank-jwt-signing-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker Compose credentials
MYSQL_ROOT_PASSWORD=Abhishek_05

# MySQL Database (InnoDB Primary Source of Truth)
# For MySQL installed on this computer, keep DB_HOST=127.0.0.1.
# Do not use "mysql" here; that hostname is only for Docker Compose.
# Runtime App User (restricted to bank_management DB)
DB_USER=bank_app
DB_PASSWORD=BankAppSecure2026!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_management
# Optional override. Leave commented to build the local URL from DB_* values above.
# DATABASE_URL=mysql+pymysql://bank_app:replace-with-your-app-password@127.0.0.1:3306/bank_management?charset=utf8mb4

# MongoDB (Fraud Graph & Application Audit)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=bank_fraud_analytics

# Redis (Caching & Rate Limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=True

# Fault Injection & Concurrency Demonstration
DEMO_FAULT_INJECTION_ENABLED=True
LOCK_TIMEOUT_SECONDS=10
